# ========================================================
# Portfolio Project with Custom CMS - Environment Variables
# Copy this file to .env and customize with your own values.
# NEVER commit your actual .env file or real secrets to Git.
# ========================================================

# -----------------------------
# Backend Configuration
# -----------------------------
SERVER_PORT=8080

# PostgreSQL Database Configuration
# Option A: Full Connection URI (used by Render, Supabase, Neon, Railway)
DATABASE_URL=postgresql://user:password@host:5432/portfolio_db?sslmode=require

# Option B: Individual Components (local development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=portfolio_db
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password_here

# JWT (JSON Web Token) Security
# Key must be at least 256 bits (32 bytes) long for HS256 algorithm
JWT_SECRET=your_256_bit_secret_key_change_this_for_production_use_only_abc123!
JWT_EXPIRATION_MS=86400000

# Initial Admin Credentials (used by seeder on first launch)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change_this_admin_password_on_first_login

# CORS (Allowed Frontend Origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload Storage Directory
UPLOAD_DIR=./uploads

# -----------------------------
# Frontend Configuration
# -----------------------------
VITE_API_BASE_URL=http://localhost:8080/api
